#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;

        // 自動マウス層をOS別に出し分ける（ドライバのautomouse-layerは無効化済み）。
        // ベース（Mac等、Win以外）: 移動で層1(MOUSE)を一時有効化。
        input-processors = <&zip_temp_layer 3 5000>;

        // iPad（デフォルト層1がアクティブ）の上書き:
        //  移動で層2(MOUSE_ipad)を一時有効化。マウス層からの戻り先もiPad(1)。
        //  スクロール反転はしない（iPadはMac同様の向き）。
        ipad {
            layers = <1>;
            // カーソル減速は snipe-layers + CONFIG_PMW3610_SNIPE_CPI で実施
            // （センサーCPIを下げる＝滑らか）。ここでは層出し分けのみ。
            input-processors = <&zip_temp_layer 4 5000>;
        };

        iphone {
            layers = <2>;
            // iPhoneは通常CPI(1000)を0.8倍=実質800に（緩やかなので滑らか）
            input-processors =
                <&zip_temp_layer 5 5000>,
                <&zip_xy_scaler 4 5>;
        };

        // Windows（デフォルト層11がアクティブ）の上書き:
        //  - 移動で層12(MOUSE_win)を一時有効化（11より上なので隠れず、
        //    マウス層からの戻り先もWindows(11)になる）
        //  - カーソルを0.6倍=実効600に（zip_xy_scaler 3 5）。物理CPIはグローバル
        //    (Mac共通1000)なので下げられず、ソフト倍率でWindowsだけ分離する。
        //    Windows側「ポインターの速度」は初期値10(等倍)に戻す前提。
        //  - スクロールを縦横とも反転（zip_scroll_transformはWHEEL/HWHEELのみ、
        //    カーソル移動は不変）
        win {
            layers = <18>;
            input-processors =
                <&zip_temp_layer 19 5000>,
                <&zip_xy_scaler 3 5>,
                <&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
};

// タイピング中のAML誤爆防止: 直前のキー入力から200ms間はマウス層を起動しない。
// require-prior-idle-ms は「起動抑制」のみ。キー押下による“即解除”とは別物なので、
// マウス層上の &kp（⌘W等）が壊れる問題は起きない（速すぎ/遅すぎれば数値調整）。
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// 注意: excluded-positions は設定しない。設定すると「キー押下でマウス層を即解除」
// する機能が働き、マウス層上の &kp（例: ⌘W）がデフォルト層側で解決されてしまう
// （⌘W→カンマ）。層からの離脱はタイムアウト／各キーの &to_layer_0 で行う。

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
