#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;

        // 自動マウス層をOS別に出し分ける（ドライバのautomouse-layerは無効化済み）。
        // ベース（Mac等、Win以外）: 移動で層1(MOUSE)を一時有効化。
        input-processors = <&zip_temp_layer 1 100000>;

        // Windows（デフォルト層11がアクティブ）の上書き:
        //  - 移動で層12(MOUSE_win)を一時有効化（11より上なので隠れず、
        //    マウス層からの戻り先もWindows(11)になる）
        //  - スクロールを縦横とも反転（zip_scroll_transformはWHEEL/HWHEELのみ、
        //    カーソル移動は不変）
        win {
            layers = <11>;
            input-processors =
                <&zip_temp_layer 12 100000>,
                <&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
};

// マウスボタンの位置はマウス層を抜けさせない（連続クリック可能にする）。
// 位置: 18/19/20=MB1/MB3/MB2(右人差し〜小指の行), 30/32=MB4/MB5。
// Mac(層1)・Windows(層12)でボタン位置は共通。
//
// require-prior-idle-ms: キー押下から200msは自動マウス層を出さない。
// これにより「P長押し＋トラックボール」でスクロールする際、P押下直後に
// マウス層が割り込まず、スクロール層(6/16)の判定が確定できる。
// ジェスチャー(O/I/U長押し)や入力直後の誤マウス化も同時に防げる。
&zip_temp_layer {
    // 18/19/20=MB1/MB3/MB2, 30/32=MB4/MB5（マウスボタン）
    // 31=LG(W)（マウス操作中に使うCmd+W。デフォルト層の同位置はCOMMAなので、
    //   マウス層を抜けるとカンマになり⌘Wが出ない→除外して層に留める）
    // ※15=LG(Q)はデフォルト層も同じLG(Q)なので抜けても発火する→除外不要
    excluded-positions = <18 19 20 30 31 32>;
    require-prior-idle-ms = <200>;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
