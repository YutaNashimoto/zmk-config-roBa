#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;

        // 自動マウス層をOS別に出し分ける（ドライバのautomouse-layerは無効化済み）。
        // ベース（Mac等、Win以外）: 移動で層1(MOUSE)を一時有効化。
        input-processors = <&zip_temp_layer 1 100000>;

        // Windows（デフォルト層11がアクティブ）の上書き:
        //  - 移動で層12(MOUSE_win)を一時有効化（11より上なので隠れず、
        //    マウス層からの戻り先もWindows(11)になる）
        //  - スクロールを縦横とも反転（zip_scroll_transformはWHEEL/HWHEELのみ、
        //    カーソル移動は不変）
        win {
            layers = <11>;
            input-processors =
                <&zip_temp_layer 12 100000>,
                <&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
};

// 注意: zip_temp_layer に excluded-positions / require-prior-idle-ms は
// あえて設定しない。設定すると「キー押下でマウス層を即解除」する機能が働き、
// マウス層上の &kp（例: ⌘W）がデフォルト層側で解決されてしまう（⌘W→カンマ）。
// 未設定なら、元のドライバ automouse と同じく「移動で層を出し、タイムアウト
// (100000ms=param2)で抜ける／個別キーは層の &to_layer_0 で抜ける」挙動になる。

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
