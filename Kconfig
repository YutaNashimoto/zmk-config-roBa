# ホストOS判定（USB有線時のみ）。有効化しない限り何もビルドされない。
config ZMK_OS_DETECTION
	bool "Detect host OS over USB and switch default layer"
	default n
	depends on ZMK_USB
	select USB_DEVICE_OS_DESC

if ZMK_OS_DETECTION

config ZMK_OS_DETECTION_DEBOUNCE_MS
	int "Debounce time (ms) after last string descriptor request"
	default 400

config ZMK_OS_DETECTION_LAYER_MACOS
	int "Default layer for macOS"
	default 0

config ZMK_OS_DETECTION_LAYER_IOS
	int "Default layer for iOS/iPadOS"
	default 1

config ZMK_OS_DETECTION_LAYER_WINDOWS
	int "Default layer for Windows"
	default 16

config ZMK_OS_DETECTION_LAYER_LINUX
	int "Default layer for Linux"
	default 16

config ZMK_OS_DETECTION_REVERT_ON_DISCONNECT
	bool "Revert to disconnect layer when USB is unplugged"
	default y

config ZMK_OS_DETECTION_DISCONNECT_LAYER
	int "Layer to revert to on USB disconnect"
	default 0

endif

# BLEプロファイル番号を機器名に反映（roBa_1, roBa_2 ...）
config ZMK_BLE_PROFILE_NAME
	bool "Append active BLE profile number to the advertised device name"
	default n
	depends on ZMK_BLE

config ZMK_BLE_PROFILE_NAME_PREFIX
	string "Device name prefix used before the profile number"
	default "roBa"
	depends on ZMK_BLE_PROFILE_NAME
