        Window_Jesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        default_layer_win {
            bindings = <
&lt 24 Q            &kp W             &kp E         &kp R    &kp T                                                 &kp Y            &lt 23 U  &lt 22 I   &lt 21 O  &lt 20 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F    &kp G            &kp LA(F4)            &kp LS(N7)     &kp H            &kp J     &kp K      &kp L     &lt 19 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V    &kp B            &lt 16 LS(MINUS)      &kp BACKSPACE  &kp N            &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB  &mt LCTRL LANG2  &lt 18 SPACE          &lt 17 ENTER   &mt RCTRL LANG1                                 &mt RIGHT_SHIFT ESCAPE
            >;

            // Windows: エンコーダのスクロール方向も反転（Mac=down_up / Win=up_down）

            sensor-bindings = <&encoder_msc_up_down>;
        };

        MOUSE_win {
            bindings = <
&to_layer_0_win Q             &to_layer_0_win W         &to_layer_0_win E         &to_layer_0_win R    &to_layer_0_win T                                                                           &to_layer_0_win Y         &lt_to_layer_0_win 23 U  &lt_to_layer_0_win 22 I  &lt_to_layer_0_win 21 O  &lt_to_layer_0_win 20 P
&to_layer_0_win A             &to_layer_0_win S         &to_layer_0_win D         &to_layer_0_win F    &to_layer_0_win G         &trans                               &to_layer_0_win LS(N7)       &to_layer_0_win H         &mkp_exit_AML_win MB1    &mkp_exit_AML_win MB3    &mkp_exit_AML_win MB2    &lt_to_layer_0_win 19 MINUS
&to_layer_0_win Z             &to_layer_0_win X         &to_layer_0_win C         &to_layer_0_win V    &to_layer_0_win B         &lt_to_layer_0_win 16 LS(MINUS)      &to_layer_0_win BACKSPACE    &to_layer_0_win N         &mkp_exit_AML_win MB4    &kp LC(W)                &mkp_exit_AML_win MB5    &mt_to_0_win RIGHT_SHIFT SLASH
&to_layer_0_win LEFT_CONTROL  &to_layer_0_win CAPSLOCK  &to_layer_0_win LEFT_ALT  &to_layer_0_win TAB  &mt_to_0_win LCTRL LANG2  &lt_to_layer_0_win 18 SPACE          &lt_to_layer_0_win 17 ENTER  &mt_to_0_win RCTRL LANG1                                                                             &mt_to_0_win RSHIFT ESC
            >;
        };

        SYMBOLS_win {
            bindings = <
&trans         &kp LS(N6)       &kp LS(SQT)  &kp LS(N8)  &kp LS(N9)                      &trans  &kp LS(RBKT)  &kp LS(BSLH)  &trans         &trans
&kp LS(EQUAL)  &kp DOLLAR       &kp PERCENT  &kp EQUAL   &trans      &trans      &trans  &trans  &kp LS(N8)    &kp LS(N9)    &kp SQT        &kp INT1
&kp LS(LBKT)   &kp EXCLAMATION  &kp LBKT     &kp HASH    &trans      &trans      &trans  &trans  &kp RBKT      &kp BSLH      &kp SEMICOLON  &kp LS(INT3)
&trans         &trans           &trans       &trans      &trans      &trans      &trans  &trans                                             &trans
            >;
        };

        NUM_win {
            bindings = <
&kp MINUS          &kp N7  &kp N8  &kp N9  &kp LS(SEMI)                              &trans      &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH          &kp N4  &kp N5  &kp N6  &kp LS(SQT)   &kp LC(LA(N0))      &trans  &trans      &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT N0  &kp N1  &kp N2  &kp N3  &kp PERIOD    &kp LS(MINUS)       &trans  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12
&trans             &trans  &trans  &trans  &trans        &trans              &trans  &trans                              &kp F13
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        ARROW_win {
            bindings = <
&kp ESCAPE  &kp LG(LS(LEFT))  &kp UP_ARROW    &kp LG(LS(RIGHT))  &trans                               &trans  &kp LC(LS(T))    &dup_tab_win  &trans       &trans
&kp HOME    &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp END  &kp LC(N0)      &trans      &trans  &kp LS(LC(TAB))  &kp LC(T)     &kp LC(TAB)  &trans
&trans      &kp LG(LEFT)      &kp LG(UP)      &kp LG(RIGHT)      &trans   &trans          &kp DELETE  &trans  &mkp MB4         &kp LC(W)     &mkp MB5     &trans
&trans      &trans            &trans          &trans             &trans   &trans          &trans      &trans                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LC(SEMICOLON)>;
        };

        ARROW2_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans          &kp UP_ARROW    &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans          &kp RS(COMMA)   &kp RS(PERIOD)   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL_win {
            bindings = <
&trans  &trans            &trans  &trans             &trans                           &trans  &kp LG(V)  &trans               &kp LG(LS(S))  &trans
&trans  &kp LG(LC(LEFT))  &trans  &kp LG(LC(RIGHT))  &trans  &kp K_MUTE       &trans  &trans  &trans     &kp LG(PRINTSCREEN)  &trans         &trans
&trans  &trans            &trans  &trans             &trans  &kp LG(TAB)      &trans  &trans  &trans     &trans               &trans         &trans
&trans  &trans            &trans  &trans             &trans  &trans           &trans  &trans                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        Browsing_Jesture_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(R)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        Desktop_Jesture_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Window_Jesture_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
