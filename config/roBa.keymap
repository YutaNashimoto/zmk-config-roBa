// スクロール量。&msc SCRL_UP/DOWN が SCRL_UP マクロ経由で参照するため、
// pointing.h とエンコーダbehavior(roBa_encoder_behaviors.dtsi)のincludeより
// 必ず前で定義する（後ろに置くと既定値(10)に戻りスクロールが事実上無効になる）。

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "roBa_encoder_behaviors.dtsi"

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // 自動マウス層はOS別に出し分けるため、ドライバ側は無効化(-1)。
    // roBa_R.overlay の zip_temp_layer で Mac=層1 / Windows=層12 を切替える。

    automouse-layer = <(-1)>;

    // 6=Mac SCROLL, 17=SCROLL_win（Windows用）。Windowsでもスクロールを有効化。
    // ※editorでレイヤーを増減すると番号がズレるので、SCROLL_winの位置を要確認。

    scroll-layers = <10 11 22>;

    // iPad(層1)では低速CPI(snipe)を使い、カーソルを滑らかに減速。
    // 速度は roBa_R.conf の CONFIG_PMW3610_SNIPE_CPI で調整（200刻み）。

    snipe-layers = <1 4>;

    browsing_arrows {
        layers = <12>;
        bindings =
            <&kp LC(TAB)>,
            // 右: 次のタブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LS(TAB))>,
            // 左: 前のタブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(T)>,
            // 上: 新規タブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(W)>;

        // 下: タブを閉じる

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    desktop_arrows {
        layers = <13>;
        bindings =
            <&kp LC(LEFT)>,
            // 右(逆): デスクトップ左,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(RIGHT)>,
            // 左(逆): デスクトップ右,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(UP)>,
            // 上: Mission Control,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LS(LA(D))>;

        // 下: Shift+Opt+D

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    window_arrows {
        layers = <15>;
        bindings =
            <&kp LC(LA(RIGHT))>,
            // 右: 右半分,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LA(LEFT))>,
            // 左: 左半分,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LA(ENTER))>,
            // 上: 最大化,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LS(LG(T))>;

        // 下: Shift+Cmd+T

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    // ===== Windows用ジェスチャー（層18/19/20）=====
    // Mac版(7/8/9)と別ブロックにして、Windows相当のショートカットを割当てる。

    browsing_arrows_win {
        layers = <23>;
        bindings =
            <&kp LC(TAB)>,
            // 右: 次のタブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LS(TAB))>,
            // 左: 前のタブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(T)>,
            // 上: 新規タブ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(W)>;

        // 下: タブを閉じる

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    desktop_arrows_win {
        layers = <24>;
        bindings =
            <&kp LG(LC(LEFT))>,
            // 右(逆): 仮想デスクトップ左,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(LC(RIGHT))>,
            // 左(逆): 仮想デスクトップ右,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(TAB)>,
            // 上: タスクビュー,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&dup_tab_win>;

        // 下: タブを複製（Alt+D → Alt+Enter）

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    window_arrows_win {
        layers = <25>;
        bindings =
            <&kp LG(RIGHT)>,
            // 右: 右半分スナップ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(LEFT)>,
            // 左: 左半分スナップ,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(UP)>,
            // 上: 最大化,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LS(T))>;

        // 下: 閉じたタブ復活

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    // ===== iPad用ジェスチャー（層12 = Desktop_Jesture_ipad）=====

    desktop_arrows_ipad {
        layers = <14>;
        bindings =
            <&split_left>,
            // 右: 🌐+←（Split View 左）,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&split_right>,
            // 左: 🌐+→（Split View 右）,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&app_switcher>,
            // 上: 🌐+↑（Appスイッチャー）,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&ipad_home>;

        // 下: 🌐+H（ホーム）

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        num_toggle {
            bindings = <&tog 7>;
            key-positions = <1 0>;
            layers = <0 1 2 3 4 5 7>;
        };

        num_toggle_win {
            bindings = <&tog 19>;
            key-positions = <0 1>;
            layers = <16 17 19>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <37 38>;
        };

        alfred {
            bindings = <&to_layer_0 RG(SPACE)>;
            key-positions = <41 39>;
        };

        Escape {
            bindings = <&to_layer_0 ESC>;
            key-positions = <0 39>;
        };

        Bluetooth_1 {
            bindings = <&bt_mac>;
            key-positions = <5 29>;
        };

        Bluetooth_2 {
            bindings = <&bt_ipad>;
            key-positions = <6 29>;
        };

        Bluetooth_3 {
            bindings = <&bt_iphone>;
            key-positions = <7 29>;
        };

        Bluetooth_4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <8 29>;
        };

        Bluetooth_5 {
            bindings = <&bt_win>;
            key-positions = <9 29>;
        };

        right_arrow {
            bindings = <&right_arrow>;
            key-positions = <41 20>;
        };

        left_arrow {
            bindings = <&left_arrow>;
            key-positions = <41 18>;
        };

        down_arrow {
            bindings = <&down_arrow>;
            key-positions = <41 19>;
        };

        up_arrow {
            bindings = <&up_arrow>;
            key-positions = <41 7>;
        };

        AquaVoice {
            bindings = <&kp LS(LC(LEFT_ALT))>;
            key-positions = <4 39>;
        };
    };

    macros {
        left_arrow: left_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&kp RGUI &kp Z &kp H>;
            label = "LEFT_ARROW";
        };

        down_arrow: down_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&kp RGUI &kp Z &kp J>;
            label = "DOWN_ARROW";
        };

        up_arrow: up_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&kp RGUI &kp Z &kp K>;
            label = "UP_ARROW";
        };

        right_arrow: right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&kp RGUI &kp Z &kp L>;
            label = "RIGHT_ARROW";
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_0_win: to_layer_0_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 16 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_WIN";
        };

        to_layer_0_ipad: to_layer_0_ipad {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_IPAD";
        };

        to_layer_0_iphone: to_layer_0_iphone {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 2 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_IPHONE";
        };

        // Windows: タブを複製。Alt+D でアドレスバーのURLを選択し、
        // Alt+Enter で同じURLを新規タブで開く（＝複製）。

        dup_tab_win: dup_tab_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp LA(ENTER)>;
            label = "DUP_TAB_WIN";
        };

        // iPad用 Globe(🌐)ショートカット。GLOBE保持→キーをタップ→GLOBE解放。
        // GLOBEはコンシューマ入力切替コードなので &kp GLOBE(x) は不可、マクロ必須。

        control_center: control_center {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "CONTROL_CENTER";
        };

        app_switcher: app_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APP_SWITCHER";
        };

        notif_center: notif_center {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NOTIF_CENTER";
        };

        split_left: split_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SPLIT_LEFT";
        };

        split_right: split_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SPLIT_RIGHT";
        };

        ipad_home: ipad_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IPAD_HOME";
        };

        // Bluetoothプロファイル切替＋デフォルトレイヤー切替を同時に行う。
        // prof1=Mac(0) / prof2=iPad(1) / prof3=iPhone(1) / prof5=Windows(13)。

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT_MAC";
        };

        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "BT_IPAD";
        };

        bt_iphone: bt_iphone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 2>;
            label = "BT_IPHONE";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 16>;
            label = "BT_WIN";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 3>;

            label = "MKP_EXIT_AML";
        };

        mkp_exit_AML_win: mkp_exit_AML_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 17>;

            label = "MKP_EXIT_AML_WIN";
        };

        mkp_exit_AML_ipad: mkp_exit_AML_ipad {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 4>;

            label = "MKP_EXIT_AML_IPAD";
        };

        mkp_exit_AML_iphone: mkp_exit_AML_iphone {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 5>;

            label = "MKP_EXIT_AML_IPHONE";
        };
    };

    behaviors {
        cmd_mo: cmd_mo {
            compatible = "zmk,behavior-cmd-mo";
            #binding-cells = <1>;
        };

        nomod: nomod {
            compatible = "zmk,behavior-nomod";
            #binding-cells = <1>;
        };

        ctrl_mo: ctrl_mo {
            compatible = "zmk,behavior-ctrl-mo";
            #binding-cells = <1>;
        };

        rlang: rlang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&cmd_mo>, <&kp>;
        };

        rlang_win: rlang_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&ctrl_mo>, <&kp>;
        };

        // MOUSE_win(層17)用 US記号補正: タップで層16へexitしつつUS記号を出す

        quote_us_mwin: quote_us_mwin {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&to_layer_0_win LS(N7)>, <&to_layer_0_win LS(N2)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_us_mwin: minus_us_mwin {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&to_layer_0_win MINUS>, <&to_layer_0_win LS(INT1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        equal_us_mwin: equal_us_mwin {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings =
                <&to_layer_0_win LS(MINUS)>,
                <&to_layer_0_win LS(SEMICOLON)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_minus_us_mwin: lt_minus_us_mwin {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&minus_us_mwin>;
        };

        lt_equal_us_mwin: lt_equal_us_mwin {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&equal_us_mwin>;
        };

        // JIS Windows用US記号補正(default_layer_winのみ)

        quote_us: quote_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_us: minus_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        equal_us: equal_us {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMICOLON)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_minus_us: lt_minus_us {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&minus_us>;
        };

        lt_equal_us: lt_equal_us {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&equal_us>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_0_win: lt_to_layer_0_win {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_WIN";
            bindings = <&mo>, <&to_layer_0_win>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0: mt_to_0 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        mt_to_0_win: mt_to_0_win {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0_win>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        lt_to_layer_0_ipad: lt_to_layer_0_ipad {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_IPAD";
            bindings = <&mo>, <&to_layer_0_ipad>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0_ipad: mt_to_0_ipad {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0_ipad>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        lt_to_layer_0_iphone: lt_to_layer_0_iphone {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_IPHONE";
            bindings = <&mo>, <&to_layer_0_iphone>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0_iphone: mt_to_0_iphone {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0_iphone>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 10 Q            &lt 12 W          &lt 13 E      &lt 15 R  &kp T                                                            &kp Y                   &lt 15 U  &lt 13 I   &lt 12 O  &lt 10 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F     &mt LS(LC(LEFT_ALT)) G  &kp LG(Q)        &mt GLOBE SINGLE_QUOTE  &mt LS(LC(LEFT_ALT)) H  &kp J     &kp K      &kp L     &lt 9 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V     &kp B                   &lt 6 EQUAL      &kp BACKSPACE           &lt 26 N                &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB   &mt LCMD LANG2          &lt 8 SPACE      &lt 7 ENTER             &rlang 9 LANG1                                         &lt 6 ESCAPE
            >;

            sensor-bindings = <&encoder_msc_mac_shift_hscroll>;
        };

        default_layer_ipad {
            bindings = <
&lt 11 Q            &lt 12 W          &lt 14 E      &lt 15 R  &kp T                                                    &kp Y           &lt 15 U  &lt 14 I   &lt 12 O  &lt 11 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F     &kp G           &kp LG(Q)        &mt GLOBE SINGLE_QUOTE  &kp H           &kp J     &kp K      &kp L     &lt 9 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V     &kp B           &lt 6 EQUAL      &kp BACKSPACE           &lt 26 N        &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB   &mt LCMD LANG2  &lt 8 SPACE      &lt 7 ENTER             &rlang 9 LANG1                                 &lt 6 ESCAPE
            >;

