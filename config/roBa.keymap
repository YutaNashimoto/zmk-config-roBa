#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // 自動マウス層はOS別に出し分けるため、ドライバ側は無効化(-1)。
    // roBa_R.overlay の zip_temp_layer で Mac=層1 / Windows=層12 を切替える。

    automouse-layer = <(-1)>;

    // 6=Mac SCROLL, 17=SCROLL_win（Windows用）。Windowsでもスクロールを有効化。
    // ※editorでレイヤーを増減すると番号がズレるので、SCROLL_winの位置を要確認。

    scroll-layers = <8 9 20>;

    browsing_arrows {
        layers = <10>;
        bindings =
            <&kp LC(TAB)>,
            // 右: 次のタブ,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LS(TAB))>,
            // 左: 前のタブ,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(T)>,
            // 上: 新規タブ,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LG(W)>;

        // 下: タブを閉じる

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    desktop_arrows {
        layers = <11>;
        bindings =
            <&kp LC(LEFT)>,
            // 右(逆): デスクトップ左,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(RIGHT)>,
            // 左(逆): デスクトップ右,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(UP)>,
            // 上: Mission Control,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LS(LA(D))>;

        // 下: Shift+Opt+D

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    window_arrows {
        layers = <13>;
        bindings =
            <&kp LC(LA(RIGHT))>,
            // 右: 右半分,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LA(LEFT))>,
            // 左: 左半分,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LC(LA(ENTER))>,
            // 上: 最大化,,,,,,,,,,,,,,,,,,,,,,,
            <&kp LS(LG(T))>;

        // 下: Shift+Cmd+T

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    // ===== Windows用ジェスチャー（層18/19/20）=====
    // Mac版(7/8/9)と別ブロックにして、Windows相当のショートカットを割当てる。

    browsing_arrows_win {
        layers = <21>;
        bindings =
            <&kp LC(TAB)>,
            // 右: 次のタブ,,,,,,,,,,,,
            <&kp LC(LS(TAB))>,
            // 左: 前のタブ,,,,,,,,,,,,
            <&kp LC(T)>,
            // 上: 新規タブ,,,,,,,,,,,,
            <&kp LC(W)>;

        // 下: タブを閉じる

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    desktop_arrows_win {
        layers = <22>;
        bindings =
            <&kp LG(LC(LEFT))>,
            // 右(逆): 仮想デスクトップ左,,,,,,,,,,,,
            <&kp LG(LC(RIGHT))>,
            // 左(逆): 仮想デスクトップ右,,,,,,,,,,,,
            <&kp LG(TAB)>,
            // 上: タスクビュー,,,,,,,,,,,,
            <&dup_tab_win>;

        // 下: タブを複製（Alt+D → Alt+Enter）

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    window_arrows_win {
        layers = <23>;
        bindings =
            <&kp LG(RIGHT)>,
            // 右: 右半分スナップ,,,,,,,,,,,,
            <&kp LG(LEFT)>,
            // 左: 左半分スナップ,,,,,,,,,,,,
            <&kp LG(UP)>,
            // 上: 最大化,,,,,,,,,,,,
            <&kp LC(LS(T))>;

        // 下: 閉じたタブ復活

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    // ===== iPad用ジェスチャー（層12 = Desktop_Jesture_ipad）=====

    desktop_arrows_ipad {
        layers = <12>;
        bindings =
            <&split_left>,
            // 右: 🌐+←（Split View 左）,,,,
            <&split_right>,
            // 左: 🌐+→（Split View 右）,,,,
            <&app_switcher>,
            // 上: 🌐+↑（Appスイッチャー）,,,,
            <&ipad_home>;

        // 下: 🌐+H（ホーム）

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <37 36>;
        };

        alfred {
            bindings = <&to_layer_0 RG(SPACE)>;
            key-positions = <41 39>;
        };

        Escape {
            bindings = <&to_layer_0 ESC>;
            key-positions = <0 39>;
        };

        Bluetooth_1 {
            bindings = <&bt_mac>;
            key-positions = <0 5>;
        };

        Bluetooth_2 {
            bindings = <&bt_ipad>;
            key-positions = <0 6>;
        };

        Bluetooth_3 {
            bindings = <&bt_iphone>;
            key-positions = <0 7>;
        };

        Bluetooth_4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <0 8>;
        };

        Bluetooth_5 {
            bindings = <&bt_win>;
            key-positions = <0 9>;
        };

        youtube_slow {
            bindings = <&kp RS(COMMA)>;
            key-positions = <33 31>;
        };

        youtube_fast {
            bindings = <&kp RS(PERIOD)>;
            key-positions = <33 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_0_win: to_layer_0_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 14 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_WIN";
        };

        to_layer_0_ipad: to_layer_0_ipad {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_IPAD";
        };

        // Windows: タブを複製。Alt+D でアドレスバーのURLを選択し、
        // Alt+Enter で同じURLを新規タブで開く（＝複製）。

        dup_tab_win: dup_tab_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LA(D) &kp LA(ENTER)>;
            label = "DUP_TAB_WIN";
        };

        // iPad用 Globe(🌐)ショートカット。GLOBE保持→キーをタップ→GLOBE解放。
        // GLOBEはコンシューマ入力切替コードなので &kp GLOBE(x) は不可、マクロ必須。

        control_center: control_center {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "CONTROL_CENTER";
        };

        app_switcher: app_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APP_SWITCHER";
        };

        notif_center: notif_center {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NOTIF_CENTER";
        };

        split_left: split_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SPLIT_LEFT";
        };

        split_right: split_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SPLIT_RIGHT";
        };

        ipad_home: ipad_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IPAD_HOME";
        };

        // Bluetoothプロファイル切替＋デフォルトレイヤー切替を同時に行う。
        // prof1=Mac(0) / prof2=iPad(1) / prof3=iPhone(1) / prof5=Windows(13)。

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT_MAC";
        };

        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "BT_IPAD";
        };

        bt_iphone: bt_iphone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT_IPHONE";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 14>;
            label = "BT_WIN";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 2>;

            label = "MKP_EXIT_AML";
        };

        mkp_exit_AML_win: mkp_exit_AML_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 15>;

            label = "MKP_EXIT_AML_WIN";
        };

        mkp_exit_AML_ipad: mkp_exit_AML_ipad {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 3>;

            label = "MKP_EXIT_AML_IPAD";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_0_win: lt_to_layer_0_win {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_WIN";
            bindings = <&mo>, <&to_layer_0_win>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0: mt_to_0 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        mt_to_0_win: mt_to_0_win {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0_win>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        lt_to_layer_0_ipad: lt_to_layer_0_ipad {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_IPAD";
            bindings = <&mo>, <&to_layer_0_ipad>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0_ipad: mt_to_0_ipad {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0_ipad>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        // Windows用: スクロール方向を反転したエンコーダ（UP/DOWN入替）

        encoder_msc_up_down: encoder_msc_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 24 Q            &kp W             &kp E         &kp R    &kp T                                                    &kp Y           &lt 13 U  &lt 11 I   &lt 10 O  &lt 8 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F    &kp G           &kp LG(Q)        &mt GLOBE SINGLE_QUOTE  &kp H           &kp J     &kp K      &kp L     &lt 7 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V    &kp B           &lt 4 EQUAL      &kp BACKSPACE           &kp N           &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB  &mt LCMD LANG2  &lt 6 SPACE      &lt 5 ENTER             &mt RCMD LANG1                                 &mt RIGHT_SHIFT ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        default_layer_ipad {
            bindings = <
&lt 24 Q            &kp W             &kp E         &kp R    &kp T                                                    &kp Y           &lt 13 U  &lt 12 I   &lt 10 O  &lt 9 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F    &kp G           &kp LG(Q)        &mt GLOBE SINGLE_QUOTE  &kp H           &kp J     &kp K      &kp L     &lt 7 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V    &kp B           &lt 4 EQUAL      &kp BACKSPACE           &kp N           &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB  &mt LCMD LANG2  &lt 6 SPACE      &lt 5 ENTER             &mt RCMD LANG1                                 &mt RIGHT_SHIFT ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        MOUSE {
            bindings = <
&lt_to_layer_0 24 Q     &to_layer_0 W      &to_layer_0 E         &to_layer_0 R    &to_layer_0 T                                                                 &to_layer_0 Y        &lt_to_layer_0 13 U  &lt_to_layer_0 11 I  &lt_to_layer_0 10 O  &lt_to_layer_0 8 P
&mt_to_0 LCTRL A        &to_layer_0 S      &to_layer_0 D         &to_layer_0 F    &to_layer_0 G        &kp LG(Q)                   &mt_to_0 GLOBE SINGLE_QUOTE  &to_layer_0 H        &mkp_exit_AML MB1    &mkp_exit_AML MB3    &mkp_exit_AML MB2    &lt_to_layer_0 7 MINUS
&mt_to_0 LEFT_SHIFT Z   &to_layer_0 X      &to_layer_0 C         &to_layer_0 V    &to_layer_0 B        &lt_to_layer_0 4 EQUAL      &to_layer_0 BACKSPACE        &to_layer_0 N        &mkp_exit_AML MB4    &to_layer_0 LG(W)    &mkp_exit_AML MB5    &mt_to_0 RIGHT_SHIFT SLASH
&to_layer_0 LEFT_SHIFT  &to_layer_0 LCTRL  &to_layer_0 LEFT_ALT  &to_layer_0 TAB  &mt_to_0 LCMD LANG2  &lt_to_layer_0 6 SPACE      &lt_to_layer_0 5 ENTER       &mt_to_0 RCMD LANG1                                                                 &mt_to_0 RSHIFT ESC
            >;
        };

        MOUSE_ipad {
            bindings = <
&lt_to_layer_0_ipad 24 Q     &to_layer_0_ipad W      &to_layer_0_ipad E         &to_layer_0_ipad R    &to_layer_0_ipad T                                                                           &to_layer_0_ipad Y        &lt_to_layer_0_ipad 13 U  &lt_to_layer_0_ipad 12 I  &lt_to_layer_0_ipad 10 O  &lt_to_layer_0_ipad 9 P
&mt_to_0_ipad LCTRL A        &to_layer_0_ipad S      &to_layer_0_ipad D         &to_layer_0_ipad F    &to_layer_0_ipad G        &kp LG(Q)                        &mt_to_0_ipad GLOBE SINGLE_QUOTE  &to_layer_0_ipad H        &mkp_exit_AML_ipad MB1    &mkp_exit_AML_ipad MB3    &mkp_exit_AML_ipad MB2    &lt_to_layer_0_ipad 7 MINUS
&mt_to_0_ipad LEFT_SHIFT Z   &to_layer_0_ipad X      &to_layer_0_ipad C         &to_layer_0_ipad V    &to_layer_0_ipad B        &lt_to_layer_0_ipad 4 EQUAL      &to_layer_0_ipad BACKSPACE        &to_layer_0_ipad N        &mkp_exit_AML_ipad MB4    &to_layer_0_ipad LG(W)    &mkp_exit_AML_ipad MB5    &mt_to_0_ipad RIGHT_SHIFT SLASH
&to_layer_0_ipad LEFT_SHIFT  &to_layer_0_ipad LCTRL  &to_layer_0_ipad LEFT_ALT  &to_layer_0_ipad TAB  &mt_to_0_ipad LCMD LANG2  &lt_to_layer_0_ipad 6 SPACE      &lt_to_layer_0_ipad 5 ENTER       &mt_to_0_ipad RCMD LANG1                                                                                &mt_to_0_ipad RSHIFT ESC
            >;
        };

        SYMBOLS {
            bindings = <
&trans     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans         &trans
&kp TILDE  &kp DOLLAR       &kp PERCENT   &kp CARET             &trans                 &trans      &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp NON_US_BACKSLASH
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &trans                 &trans      &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp PIPE
&trans     &trans           &trans        &trans                &trans                 &trans      &trans  &trans                                                              &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                             &trans         &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &trans  &kp COLON      &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans  &kp SEMICOLON  &kp F1  &kp F2  &kp F3  &kp F12
&trans                      &trans           &trans           &trans           &trans        &trans         &trans  &trans                                 &kp F13
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp LC(LG(LA(LEFT_ARROW)))  &kp UP_ARROW       &kp LA(LG(LC(RIGHT_ARROW)))  &trans                                        &trans  &kp LG(LS(T))    &kp LS(LA(D))  &trans       &trans
&kp HOME    &kp LEFT_ARROW              &kp DOWN_ARROW     &kp RIGHT_ARROW              &kp END  &kp LG(KP_NUMBER_0)      &trans      &trans  &kp LS(LC(TAB))  &kp LG(T)      &kp LC(TAB)  &trans
&trans      &kp LA(LC(LEFT_ARROW))      &kp LA(LC(ENTER))  &kp LA(LC(RIGHT_ARROW))      &trans   &trans                   &kp DELETE  &trans  &mkp MB4         &kp LG(W)      &mkp MB5     &trans
&trans      &trans                      &trans             &trans                       &trans   &trans                   &trans      &trans                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(EQUAL)>;
        };

        ARROW2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans          &kp UP_ARROW    &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans          &kp RS(COMMA)   &kp RS(PERIOD)   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans        &trans            &trans         &trans                                &trans  &kp LS(LC(V))  &kp LG(LA(LC(F)))     &kp LG(LS(NUMBER_4))  &trans
&trans  &kp LC(LEFT)  &kp LC(UP_ARROW)  &kp LC(RIGHT)  &trans  &kp K_MUTE            &trans  &trans  &trans         &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_7))  &trans
&trans  &trans        &trans            &trans         &trans  &kp LC(UP_ARROW)      &trans  &trans  &trans         &kp LG(LS(NUMBER_6))  &kp LG(LS(NUMBER_5))  &trans
&trans  &trans        &trans            &trans         &trans  &trans                &trans  &trans                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        SCROLL_ipad {
            bindings = <
&trans  &notif_center  &ipad_home     &control_center  &trans                             &trans  &trans  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_3))  &trans
&trans  &split_left    &app_switcher  &split_right     &trans  &kp K_MUTE         &trans  &trans  &trans  &notif_center         &control_center       &trans
&trans  &trans         &trans         &trans           &trans  &app_switcher      &trans  &trans  &trans  &trans                &trans                &trans
&trans  &trans         &trans         &trans           &trans  &trans             &trans  &trans                                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        Browsing_Jesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(R)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
