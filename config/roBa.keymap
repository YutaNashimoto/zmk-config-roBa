#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <1>;
    scroll-layers = <6>;

    browsing_arrows {
        layers = <7>;
        bindings =
            <&kp LC(TAB)>,
            // 右: 次のタブ,,
            <&kp LC(LS(TAB))>,
            // 左: 前のタブ,,
            <&kp LG(T)>,
            // 上: 新規タブ,,
            <&kp LG(W)>;

        // 下: タブを閉じる

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    desktop_arrows {
        layers = <8>;
        bindings =
            <&kp LC(LEFT)>,
            // 右(逆): デスクトップ左,,
            <&kp LC(RIGHT)>,
            // 左(逆): デスクトップ右,,
            <&kp LC(UP)>,
            // 上: Mission Control,,
            <&kp LS(LA(D))>;

        // 下: Shift+Opt+D

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    window_arrows {
        layers = <9>;
        bindings =
            <&kp LC(LA(RIGHT))>,
            // 右: 右半分,,
            <&kp LC(LA(LEFT))>,
            // 左: 左半分,,
            <&kp LC(LA(ENTER))>,
            // 上: 最大化,,
            <&kp LS(LG(T))>;

        // 下: Shift+Cmd+T

        tick = <150>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <37 36>;
        };

        alfred {
            bindings = <&kp RG(SPACE)>;
            key-positions = <41 39>;
        };

        Escape {
            bindings = <&kp ESC>;
            key-positions = <0 39>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;

            label = "MKP_EXIT_AML";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_0: mt_to_0 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 10 Q            &kp W             &kp E         &kp R    &kp T                                              &kp Y           &lt 9 U  &lt 8 I    &lt 7 O  &lt 6 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F    &kp G           &kp LG(Q)        &kp SINGLE_QUOTE  &kp H           &kp J    &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V    &kp B           &lt 2 EQUAL      &kp BACKSPACE     &kp N           &kp M    &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_SHIFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp TAB  &mt LCMD LANG2  &lt 4 SPACE      &lt 3 ENTER       &mt RCMD LANG1                               &mt RIGHT_SHIFT ESCAPE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        MOUSE {
            bindings = <
&to_layer_0 Q             &to_layer_0 W         &to_layer_0 E         &to_layer_0 R    &to_layer_0 T                                                              &to_layer_0 Y        &lt_to_layer_0 9 U  &lt_to_layer_0 8 I  &lt_to_layer_0 7 O  &lt_to_layer_0 6 P
&to_layer_0 A             &to_layer_0 S         &to_layer_0 D         &to_layer_0 F    &to_layer_0 G        &trans                      &to_layer_0 SINGLE_QUOTE  &to_layer_0 H        &mkp_exit_AML MB1   &mkp_exit_AML MB3   &mkp_exit_AML MB2   &lt_to_layer_0 5 MINUS
&to_layer_0 Z             &to_layer_0 X         &to_layer_0 C         &to_layer_0 V    &to_layer_0 B        &lt_to_layer_0 2 EQUAL      &to_layer_0 BACKSPACE     &to_layer_0 N        &mkp_exit_AML MB4   &kp LG(W)           &mkp_exit_AML MB5   &mt_to_0 RIGHT_SHIFT SLASH
&to_layer_0 LEFT_CONTROL  &to_layer_0 CAPSLOCK  &to_layer_0 LEFT_ALT  &to_layer_0 TAB  &mt_to_0 LCMD LANG2  &lt_to_layer_0 4 SPACE      &lt_to_layer_0 3 ENTER    &mt_to_0 RCMD LANG1                                                              &mt_to_0 RSHIFT ESC
            >;
        };

        SYMBOLS {
            bindings = <
&trans     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans         &trans
&kp TILDE  &kp DOLLAR       &kp PERCENT   &kp CARET             &trans                 &trans      &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp NON_US_BACKSLASH
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &trans                 &trans      &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp PIPE
&trans     &trans           &trans        &trans                &trans                 &trans      &trans  &trans                                                              &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                           &trans      &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &trans  &trans      &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans  &trans                              &kp F13
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp LC(LG(LA(LEFT_ARROW)))  &kp UP_ARROW       &kp LA(LG(LC(RIGHT_ARROW)))  &trans                                        &trans  &kp LG(LS(T))    &kp LS(LA(D))  &trans       &trans
&kp HOME    &kp LEFT_ARROW              &kp DOWN_ARROW     &kp RIGHT_ARROW              &kp END  &kp LG(KP_NUMBER_0)      &trans      &trans  &kp LS(LC(TAB))  &kp LG(T)      &kp LC(TAB)  &trans
&trans      &kp LA(LC(LEFT_ARROW))      &kp LA(LC(ENTER))  &kp LA(LC(RIGHT_ARROW))      &trans   &trans                   &kp DELETE  &trans  &mkp MB4         &kp LG(W)      &mkp MB5     &trans
&trans      &trans                      &trans             &trans                       &trans   &trans                   &trans      &trans                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(EQUAL)>;
        };

        ARROW2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans          &kp UP_ARROW    &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans        &trans  &trans         &trans                                &trans  &kp LS(LC(V))  &kp LG(LA(LC(F)))     &kp LG(LS(NUMBER_4))  &trans
&trans  &kp LC(LEFT)  &trans  &kp LC(RIGHT)  &trans  &kp K_MUTE            &trans  &trans  &trans         &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_7))  &trans
&trans  &trans        &trans  &trans         &trans  &kp LC(UP_ARROW)      &trans  &trans  &trans         &kp LG(LS(NUMBER_6))  &kp LG(LS(NUMBER_5))  &trans
&trans  &trans        &trans  &trans         &trans  &trans                &trans  &trans                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        Browsing_Jesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Desktop_Jesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Window_Jesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &ind_bat      &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
