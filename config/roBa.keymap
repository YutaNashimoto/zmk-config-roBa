        BLUETOOTH {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt_mac  &bt_ipad  &bt_iphone  &bt BT_SEL 3  &bt_win
&to 0   &trans        &to 14        &trans        &trans  &trans      &trans       &trans   &trans    &trans      &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans   &trans    &trans      &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                       &bt BT_CLR_ALL
            >;
        };

        // レイヤー31: 横画面モード。有効な間トラックボールのX/Yを入れ替える
        // （入れ替えは roBa_R.overlay の trackball_listener 側で設定）。
        // 全キー透過なので、このモード中も通常の打鍵はそのまま使える。
    };
};
