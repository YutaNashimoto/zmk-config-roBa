&kp LEFT_SHIFT               &kp LEFT_GUI             &kp LEFT_ALT             &to_layer_0_win TAB      &mt_to_0_win LCTRL LANG2  &lt_to_layer_0_win 20 SPACE      &lt_to_layer_0_win 19 ENTER  &rlang_win 21 LANG1                                                                                 &lt_to_layer_0_win 18 ESC
            >;
